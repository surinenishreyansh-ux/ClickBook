# ==============================================================================
# CLICKBOOK BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
SECRET_KEY=clickbook-insecure-dev-key-change-in-production

# Neon PostgreSQL connection string or SQLite for local offline testing
# Production (Neon):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-sample-1234.us-east-2.aws.neon.tech/clickbook?sslmode=require
# Local fallback default:
DATABASE_URL=sqlite:///data/clickbook.sqlite3

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Storage Driver: 'cloudinary', 'r2', or 'local'
STORAGE_DRIVER=local

# Cloudinary (set STORAGE_DRIVER=cloudinary when ready)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_ASSET_MB=10

# Cloudflare R2 Credentials (when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Networking & CORS
FRONTEND_URL=http://localhost:5173
CLICKBOOK_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
MAX_IMAGE_MB=25
FACE_THRESHOLD=0.43
CLUSTER_THRESHOLD=0.48
