# ==============================================================================
# CLICKBOOK PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit the .env file containing real secrets to version control.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=production

# Strong random secret key for session signing and cryptographic tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_character_random_hex_string

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string with SSL required
# Format: postgresql+psycopg://<username>:<password>@<neon_endpoint>.neon.tech/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://clickbook_user:replace_with_strong_password@ep-cool-sample-123456.us-east-2.aws.neon.tech/clickbook_prod?sslmode=require

# Database Connection Pool Settings (Optimized for Neon compute auto-suspend)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# STORAGE CONFIGURATION (Cloudflare R2 - S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
# Set to 'r2' for Cloudflare R2 cloud storage, or 'local' for local disk development
STORAGE_DRIVER=r2

# Your Cloudflare Account ID (32-character hex found in Cloudflare Dashboard sidebar)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare R2 S3 API credentials (Generated under R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# The private R2 bucket name
R2_BUCKET_NAME=clickbook-photos-prod

# Optional explicit endpoint (automatically generated from R2_ACCOUNT_ID if omitted):
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Optional public CDN base URL (if custom domain is assigned to bucket in Cloudflare)
R2_PUBLIC_BASE_URL=

# Maximum upload image size in megabytes
MAX_IMAGE_MB=25

# ------------------------------------------------------------------------------
# AI & BIOMETRICS CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API Key for semantic image understanding & moment tagging
# Obtain from Google AI Studio: https://aistudio.google.com/
# Leave empty or omit if you wish to run with Gemini disabled.
GEMINI_API_KEY=

# Supported Gemini Vision model
GEMINI_MODEL=gemini-2.5-flash

# OpenCV SFace face matching thresholds (0.0 to 1.0)
# Lower values increase recall; higher values reduce false positives.
FACE_THRESHOLD=0.43
CLUSTER_THRESHOLD=0.48

# ------------------------------------------------------------------------------
# NETWORKING, CORS & DOMAINS
# ------------------------------------------------------------------------------
# The primary public URL of your Cloudflare Pages frontend
FRONTEND_URL=https://photos.yourdomain.com

# Comma-separated list of allowed CORS origins
CLICKBOOK_ORIGINS=https://photos.yourdomain.com,http://localhost:5173,http://localhost:8000

# Primary domain for Oracle Cloud Caddy reverse proxy HTTPS Let's Encrypt certificates
DOMAIN=api.yourdomain.com
